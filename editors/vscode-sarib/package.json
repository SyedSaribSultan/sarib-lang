{
  "name": "vscode-sarib",
  "displayName": "sarib",
  "description": "Syntax highlighting for .sarib knowledge files (Markdown superset).",
  "version": "0.3.1",
  "publisher": "sarib",
  "license": "MIT",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:sarib", "onCommand:sarib.preview"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The preview runs a Python interpreter and may load a sarib checkout found in the workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "sarib.preview",
        "title": "sarib: Open Preview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "sarib.preview",
          "when": "editorLangId == sarib",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sarib.preview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == sarib"
      }
    ],
    "configuration": {
      "title": "sarib",
      "properties": {
        "sarib.pythonPath": {
          "type": "string",
          "default": "python",
          "scope": "machine",
          "description": "Python executable used to run the previewer."
        },
        "sarib.previewScript": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to a repo checkout's tools/preview.py. Leave empty to auto-detect: a sarib checkout above the open file or in the workspace folders, else the installed `sarib` Python package (works in any folder)."
        }
      }
    },
    "languages": [
      {
        "id": "sarib",
        "aliases": ["sarib", "Sarib"],
        "extensions": [".sarib"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sarib",
        "scopeName": "text.html.markdown.sarib",
        "path": "./syntaxes/sarib.tmLanguage.json"
      }
    ]
  }
}
